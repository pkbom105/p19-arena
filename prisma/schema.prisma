generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Court {
  id           String    @id @default(cuid())
  name         String
  description  String?
  pricePerHour Int       @default(300)
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
}

model TimeSlot {
  id        String    @id @default(cuid())
  startTime String
  endTime   String
  dayOfWeek Int
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model RentalEquipment {
  id           String   @id @default(cuid())
  name         String
  nameEn       String?
  pricePerUnit Int
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id             String    @id @default(cuid())
  lineUserId     String?   @unique
  lineDisplayName String?
  linePictureUrl String?
  name           String?
  phone          String?
  email          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]
}

model Booking {
  id            String   @id @default(cuid())
  ticketCode    String?  @unique
  courtId       String
  timeSlotId    String
  userId        String?
  bookingDate   String
  status        String   @default("pending")
  playerName    String
  playerPhone   String
  playerEmail   String?
  note          String?
  racketCount   Int      @default(0)
  slipName      String?
  slipDataUrl   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  court         Court    @relation(fields: [courtId], references: [id])
  timeSlot      TimeSlot @relation(fields: [timeSlotId], references: [id])
  user          User?    @relation(fields: [userId], references: [id])

  @@unique([courtId, timeSlotId, bookingDate])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model PriceRule {
  id        String    @id @default(cuid())
  name      String?
  days      String?   // "0,1,2,3,4,5,6" = ตัวเลขวัน (0=อาทิตย์..6=เสาร์); null/"" = ทุกวัน
  startTime String
  endTime   String
  price     Int
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// การจองโค้ช (จริง) — 1 แถวต่อ 1 ครั้งที่จอง = โค้ช + สนาม + วัน/เวลาหลายชั่วโมง
// เก็บ snapshot ชื่อ/ราคาของโค้ชและสนามไว้ด้วย เพื่อให้ยอดเงินย้อนหลังไม่เปลี่ยนเมื่อแก้ราคาปลายทาง
// (ไม่มี relation กับ Court/TimeSlot โดยเจตนา — สนาม/ช่วงเวลาจริงถูกบันทึกเป็นแถว Booking คู่กัน)
model CoachBooking {
  id              String   @id @default(cuid())
  ticketCode      String?  @unique
  coachId         String
  coachName       String
  /** ราคาโค้ชต่อชั่วโมง ณ เวลาที่จอง */
  coachPrice      Int
  courtId         String
  courtName       String
  bookingDate     String
  /** เวลาเริ่มของแต่ละชั่วโมง คั่นด้วย comma เช่น "09:00,10:00" */
  startTimes      String
  hours           Int
  /** ค่าสนามรวม (คิดตาม PriceRule ของวันนั้น) */
  courtTotal      Int      @default(0)
  /** ค่าโค้ชรวม = hours × coachPrice */
  coachTotal      Int
  totalPrice      Int
  /** id ของ Booking (สนาม) ที่สร้างคู่กัน — JSON array เช่น ["id1","id2"] */
  courtBookingIds String?
  playerName      String
  playerPhone     String
  playerEmail     String?
  note            String?
  slipName        String?
  slipDataUrl     String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// โค้ช — รายชื่อโค้ช (แก้ไขได้จากหน้า /dashboard/shop-setting?section=coach)
model Coach {
  id              String   @id @default(cuid())
  name            String
  initial         String   @default("")
  level           String   @default("")
  pricePerHour    Int      @default(0)
  experienceYears Int      @default(0)
  specialties     String   @default("") // คั่นด้วย comma
  availableDays   String   @default("")
  rating          Float    @default(0)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Error tracking / crash reporting (self-hosted) — บันทึก error ฝั่ง server + client
model ErrorLog {
  id        String   @id @default(cuid())
  level     String   @default("error") // error | unhandledRejection | client | crash
  message   String
  stack     String?
  path      String?  // URL/path ที่เกิด error
  userAgent String?
  source    String   @default("server") // server | client | middleware
  createdAt DateTime @default(now())
}

// สินค้าของร้าน (POS Shop) — ของ "ขาย" แยกจาก RentalEquipment ที่เป็นของ "เช่า"
model ShopProduct {
  id        String   @id @default(cuid())
  name      String
  nameEn    String?
  /** อ้างถึง ShopCategory.id (เช่น cloth | racket | food) — เพิ่มหมวดใหม่ได้ที่หน้า /dashboard/shop-setting */
  category  String
  /** ราคาขายต่อหน่วย (บาท) */
  price     Int
  /** จำนวนสต็อกเริ่มต้น (กรอกที่หน้าตั้งค่า) — คงเหลือ = จำนวนเริ่มต้น − จำนวนที่ขายได้จริงจากบิล (ติดลบได้) */
  stockStart Int     @default(0)
  /** ราคาทุนต่อหน่วย (บาท) — กำไรต่อหน่วย = ราคาขาย − ราคาทุน */
  costPrice  Int     @default(0)
  unit      String   @default("ชิ้น")
  emoji     String?
  /** บาร์โค้ดสินค้า (EAN/UPC หรือรหัสภายในร้าน) — เว้นว่างได้ */
  barcode   String?
  /** ปิดใช้งาน = ซ่อนจากหน้าแคชเชียร์ (soft delete — ห้ามลบจริงเพราะบิลเก้าอ้างอิง) */
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isActive, sortOrder])
}

// หมวดสินค้าของร้าน (POS Shop) — เพิ่มหมวดใหม่ได้จากหน้า /dashboard/shop-setting
// id เป็นคีย์อ้างอิงที่เก็บไว้ใน ShopProduct.category (ไม่ผูก FK เพื่อไม่กระทบแถวสินค้าเดิม)
model ShopCategory {
  id        String   @id // เช่น cloth | racket | food
  label     String
  labelEn   String?
  emoji     String?
  /** ปิดใช้งาน = ซ่อนจากแท็บ/ตัวเลือก (ไม่ลบ เพราะสินค้าเดิมยังอ้างอิง id นี้) */
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ใบเสร็จที่ปิดการขายจากหน้าแคชเชียร์ (/dashboard/pos-shop) — บันทึกจริงลง DB แล้ว
// (ก่อนหน้านี้เป็น state ในหน้าจอเท่านั้น → บิลหายเมื่อ refresh) · no = เลขที่บิลรันต่อวัน
model ShopReceipt {
  id        String   @id @default(cuid())
  /** เลขที่บิลที่แสดงให้ลูกค้า รูปแบบ S-YYMM### (YYMM = ปี/เดือนที่ขาย · ### = running 3 หลักรีเซ็ตรายเดือน) */
  code      String   @unique
  no        Int
  /** ยอดรวมสินค้าก่อนหักส่วนลด (บาท) */
  subtotal  Int
  discount  Int      @default(0)
  /** ยอดสุทธิที่เก็บจากลูกค้า */
  total     Int
  /** cash | transfer */
  method    String
  received  Int
  change    Int      @default(0)
  /** จำนวนชิ้นรวมในบิล */
  itemCount Int
  soldAt    DateTime @default(now())
  createdAt DateTime @default(now())
  items     ShopReceiptItem[]

  @@index([soldAt])
}

// รายการสินค้าในใบเสร็จ 1 ใบ (เก็บชื่อ/ราคา ณ วันที่ขาย — สินค้าถูกลบทีหลังก็ยังดูย้อนหลังได้)
model ShopReceiptItem {
  id        String      @id @default(cuid())
  receiptId String
  receipt   ShopReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  name      String
  qty       Int
  price     Int
  /** หมายเหตุแนบท้ายรายการ (เช่น วัน/เวลา จองโค้ช) */
  note      String?

  @@index([receiptId])
}

