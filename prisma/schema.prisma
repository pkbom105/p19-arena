generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Court {
  id           String    @id @default(cuid())
  name         String
  description  String?
  pricePerHour Int       @default(300)
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
}

model TimeSlot {
  id        String    @id @default(cuid())
  startTime String
  endTime   String
  dayOfWeek Int
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model RentalEquipment {
  id           String   @id @default(cuid())
  name         String
  nameEn       String?
  pricePerUnit Int
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id             String    @id @default(cuid())
  lineUserId     String?   @unique
  lineDisplayName String?
  linePictureUrl String?
  name           String?
  phone          String?
  email          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]
}

model Booking {
  id            String   @id @default(cuid())
  ticketCode    String?  @unique
  courtId       String
  timeSlotId    String
  userId        String?
  bookingDate   String
  status        String   @default("pending")
  playerName    String
  playerPhone   String
  playerEmail   String?
  note          String?
  racketCount   Int      @default(0)
  slipName      String?
  slipDataUrl   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  court         Court    @relation(fields: [courtId], references: [id])
  timeSlot      TimeSlot @relation(fields: [timeSlotId], references: [id])
  user          User?    @relation(fields: [userId], references: [id])

  @@unique([courtId, timeSlotId, bookingDate])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model PriceRule {
  id        String    @id @default(cuid())
  name      String?
  days      String?   // "0,1,2,3,4,5,6" = ตัวเลขวัน (0=อาทิตย์..6=เสาร์); null/"" = ทุกวัน
  startTime String
  endTime   String
  price     Int
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// การจองโค้ช (จริง) — 1 แถวต่อ 1 ครั้งที่จอง = โค้ช + สนาม + วัน/เวลาหลายชั่วโมง
// เก็บ snapshot ชื่อ/ราคาของโค้ชและสนามไว้ด้วย เพื่อให้ยอดเงินย้อนหลังไม่เปลี่ยนเมื่อแก้ราคาปลายทาง
// (ไม่มี relation กับ Court/TimeSlot โดยเจตนา — สนาม/ช่วงเวลาจริงถูกบันทึกเป็นแถว Booking คู่กัน)
model CoachBooking {
  id              String   @id @default(cuid())
  ticketCode      String?  @unique
  coachId         String
  coachName       String
  /** ราคาโค้ชต่อชั่วโมง ณ เวลาที่จอง */
  coachPrice      Int
  courtId         String
  courtName       String
  bookingDate     String
  /** เวลาเริ่มของแต่ละชั่วโมง คั่นด้วย comma เช่น "09:00,10:00" */
  startTimes      String
  hours           Int
  /** ค่าสนามรวม (คิดตาม PriceRule ของวันนั้น) */
  courtTotal      Int      @default(0)
  /** ค่าโค้ชรวม = hours × coachPrice */
  coachTotal      Int
  totalPrice      Int
  /** id ของ Booking (สนาม) ที่สร้างคู่กัน — JSON array เช่น ["id1","id2"] */
  courtBookingIds String?
  playerName      String
  playerPhone     String
  playerEmail     String?
  note            String?
  slipName        String?
  slipDataUrl     String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Error tracking / crash reporting (self-hosted) — บันทึก error ฝั่ง server + client
model ErrorLog {
  id        String   @id @default(cuid())
  level     String   @default("error") // error | unhandledRejection | client | crash
  message   String
  stack     String?
  path      String?  // URL/path ที่เกิด error
  userAgent String?
  source    String   @default("server") // server | client | middleware
  createdAt DateTime @default(now())
}
